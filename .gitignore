.idea
.vscode/
.DS_Store

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.plan
terraform/.env
terraform/terraform.tfvars

# Built by the archive provider from lambda/*.py (spec §5.8)
terraform/lambda/*.zip

# Ansible: inventory is generated from `terraform output` by `make inventory`
ansible/inventory/hosts.ini
*.retry

# Never commit decrypted secrets. The *.enc.env files ARE safe to commit.
secrets/*.dec*
secrets/*.plain*
