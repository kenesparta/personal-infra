# Managed by Ansible (personal-infra, role: deploy) — edits will be reverted.
# Project: {{ item.name }} (from projects.yml)
name: {{ item.name }}

services:
  {{ item.name }}:
    # AD-10 — GHCR, not ECR. A Lightsail instance cannot assume an IAM role
    # (G5), so ECR would mean an access key on disk plus a second timer
    # refreshing the 12-hour token. The tag is deliberately a MOVING one: the
    # timer's `docker compose pull` is what makes a release go live, so pinning
    # a digest here would stop deploys entirely.
    image: {{ item.image }}:{{ item.tag | default('latest') }}
    container_name: {{ item.name }}
    restart: unless-stopped

    # No `ports:` (acceptance criterion 9). Caddy reaches this over `web` as
    # {{ item.name }}:{{ item.port }}, and nothing else can reach it at all.
    networks:
      - {{ docker_network }}

    env_file:
      - .env

    # AD-11 — stdout/stderr ship to {{ cloudwatch_log_group_prefix }}/{{ item.name }}
    # (7-day retention, terraform/cloudwatch-logs.tf). The group must exist
    # BEFORE the container starts: the writer key cannot create groups, and a
    # missing one fails the start (G21). non-blocking: when CloudWatch is
    # unreachable, drop lines rather than stall the app's stdout. `docker logs`
    # keeps working via the dual-logging cache.
    logging:
      driver: awslogs
      options:
        awslogs-region: {{ cloudwatch_log_region }}
        awslogs-group: {{ cloudwatch_log_group_prefix }}/{{ item.name }}
        awslogs-stream: {{ item.name }}
        mode: non-blocking
        max-buffer-size: 4m

networks:
  {{ docker_network }}:
    external: true
