# Managed by Ansible (personal-infra, role: deploy) — edits will be reverted.
# Project: {{ item.name }}. Mode 0600, root-owned.

# AD-3 — `postgres` is a Docker DNS name on the `{{ docker_network }}` network, NOT the host.
# This deliberately does not say 127.0.0.1: inside a bridge-networked container
# that is the container's own loopback, and the database is not there.
#
# The password is percent-encoded because it lands in the userinfo of a URL.
# The explicit replace() is not redundant: Jinja's urlencode treats "/" as safe
# and leaves it alone, which is correct for a path and wrong here — an
# unescaped "/" ends the authority component, and `openssl rand -base64` emits
# one about half the time. Everything else that matters (+, =, @, :, %) the
# filter already handles.
DATABASE_URL=postgres://{{ item.name }}:{{ vault_postgres_passwords[item.name] | urlencode | replace('/', '%2F') }}@{{ postgres_container }}:5432/{{ item.database }}

{% for k, v in (item.env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
{% if item.origin_gate_env is defined %}
# App-level origin gate: the SAME value Caddy compares (G13 — one source, one
# rotation). The app rejects requests whose X-Origin-Verify does not match.
{{ item.origin_gate_env }}={{ vault_origin_secret }}
{% endif %}
{% for k, v in (vault_project_env | default({})).get(item.name, {}).items() %}
{{ k }}={{ v }}
{% endfor %}
