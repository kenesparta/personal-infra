# Managed by Ansible (personal-infra, role: docker) — edits will be reverted.
#
# The host's ONLY static AWS credential (AD-11, G21). The awslogs driver runs
# inside dockerd, and the instance's metadata credentials cover only the
# backup bucket (G5), so the daemon takes this IAM user's key from its
# environment. Scoped to logs:CreateLogStream / logs:PutLogEvents on
# /kenesparta/* — worst case on leak is noise in those log groups. Root-only
# (0600); containers cannot read the daemon's environment, so the metadata
# guard's threat model (G16) is unchanged.
[Service]
Environment=AWS_ACCESS_KEY_ID={{ vault_cloudwatch_access_key_id }}
Environment=AWS_SECRET_ACCESS_KEY={{ vault_cloudwatch_secret_access_key }}
