# Managed by Ansible (personal-infra, role: caddy) — edits will be reverted.
# Mode 0600, root-owned.
#
# ORIGIN_SECRET must be byte-identical to the X-Origin-Verify custom_header on
# every CloudFront distribution. Rotation is two-sided and ORDERED — Terraform
# first, then this file — or every request 403s in the gap (G13).
ACME_EMAIL={{ caddy_acme_email }}
ORIGIN_SECRET={{ vault_origin_secret }}
